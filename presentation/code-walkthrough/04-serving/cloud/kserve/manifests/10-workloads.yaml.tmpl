apiVersion: serving.kserve.io/v1beta1
kind: InferenceService
metadata:
  name: expert-shufflenet
  namespace: pertinence-serving
  labels:
    app.kubernetes.io/part-of: pertinence
    pertinence.dev/benchmark-role: expert
  annotations:
    serving.kserve.io/deploymentMode: Standard
    pertinence.dev/promotion-fingerprint: "${PROMOTION_FINGERPRINT}"
spec:
  predictor:
    minReplicas: 1
    maxReplicas: 1
    storageUris:
      - uri: "oci://${SHUFFLENET_MODELCAR}"
        mountPath: /mnt/models
    serviceAccountName: serving-runner
    nodeSelector:
      cloud.google.com/gke-nodepool: serving-pool
    tolerations:
      - key: workload
        operator: Equal
        value: pertinence-serving
        effect: NoSchedule
    securityContext:
      runAsNonRoot: true
      runAsUser: 65532
      runAsGroup: 65532
      fsGroup: 65532
      seccompProfile:
        type: RuntimeDefault
    containers:
      - name: kserve-container
        image: "${RUNTIME_IMAGE}"
        imagePullPolicy: IfNotPresent
        args:
          - serve
          - expert
          - --model-name
          - shufflenetv2_x0_5
          - --model-path
          - /mnt/models/model.onnx
          - --model-sha256
          - "${SHUFFLENET_MODEL_SHA256}"
          - --features-name
          - features
          - --feature-dim
          - "1024"
          - --host
          - 0.0.0.0
          - --port
          - "8080"
        env:
          - name: ORT_INTRA_OP_NUM_THREADS
            value: "1"
          - name: ORT_INTER_OP_NUM_THREADS
            value: "1"
          - name: PERTINENCE_WORKERS
            value: "1"
        ports:
          - name: http-v2
            containerPort: 8080
        resources:
          requests:
            cpu: "1"
            memory: 1Gi
          limits:
            cpu: "1"
            memory: 1Gi
        securityContext:
          allowPrivilegeEscalation: false
          capabilities:
            drop: ["ALL"]
          readOnlyRootFilesystem: true
          runAsNonRoot: true
          runAsUser: 65532
        startupProbe:
          httpGet:
            path: /v2/health/ready
            port: http-v2
          failureThreshold: 60
          periodSeconds: 2
        readinessProbe:
          httpGet:
            path: /v2/health/ready
            port: http-v2
          periodSeconds: 2
          timeoutSeconds: 1
          failureThreshold: 3
        livenessProbe:
          httpGet:
            path: /v2/health/live
            port: http-v2
          periodSeconds: 10
          timeoutSeconds: 1
          failureThreshold: 3
---
