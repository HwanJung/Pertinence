apiVersion: batch/v1
kind: Job
metadata:
  name: pertinence-loadgen
  namespace: pertinence-serving
  labels:
    app.kubernetes.io/part-of: pertinence
    pertinence.dev/benchmark-role: loadgen
spec:
  # Applying manifests must not start a benchmark accidentally. Unsuspend only after preflight.
  suspend: true
  parallelism: 1
  completions: 1
  backoffLimit: 0
  activeDeadlineSeconds: 43200
  template:
    metadata:
      labels:
        app.kubernetes.io/part-of: pertinence
        pertinence.dev/benchmark-role: loadgen
    spec:
      restartPolicy: Never
      serviceAccountName: benchmark-runner
      nodeSelector:
        cloud.google.com/gke-nodepool: loadgen-pool
      tolerations:
        - key: workload
          operator: Equal
          value: pertinence-loadgen
          effect: NoSchedule
      securityContext:
        runAsNonRoot: true
        runAsUser: 65532
        runAsGroup: 65532
        fsGroup: 65532
        seccompProfile: {type: RuntimeDefault}
      initContainers:
        - name: evidence-collector
          image: "${RUNTIME_IMAGE}"
          imagePullPolicy: IfNotPresent
          restartPolicy: Always
          args:
            - benchmark
            - collect-evidence
            - --output
            - "/work/${BENCHMARK_ID}/evidence.jsonl"
            - --done
            - /work/loadgen.done
            - --completed
            - /work/collector.done
          resources:
            requests: {cpu: 100m, memory: 128Mi}
            limits: {cpu: 100m, memory: 128Mi}
          securityContext:
            allowPrivilegeEscalation: false
            capabilities: {drop: ["ALL"]}
            readOnlyRootFilesystem: true
            runAsNonRoot: true
            runAsUser: 65532
          volumeMounts:
            - {name: work, mountPath: /work}
      containers:
        - name: loadgen
          image: "${RUNTIME_IMAGE}"
          imagePullPolicy: IfNotPresent
          args:
            - benchmark
            - run
            - --trace
            - /work/trace
            - --trace-uri
            - "${BENCHMARK_TRACE_URI}"
            - --promotion
            - /etc/pertinence/promotion.json
            - --config
            - /etc/benchmark/benchmark.yaml
            - --endpoint
            - resnet56=http://expert-resnet56-predictor.pertinence-serving.svc.cluster.local
            - --endpoint
            - dispatcher-000733=http://router-dispatcher-000733-predictor.pertinence-serving.svc.cluster.local
            - --output
            - "/work/${BENCHMARK_ID}"
            - --output-uri
            - "${BENCHMARK_OUTPUT_URI}"
            - --collector-done
            - /work/loadgen.done
            - --collector-completed
            - /work/collector.done
          env:
            - {name: ORT_INTRA_OP_NUM_THREADS, value: "1"}
            - {name: ORT_INTER_OP_NUM_THREADS, value: "1"}
            - {name: PERTINENCE_WORKERS, value: "1"}
          resources:
            requests:
              cpu: "1"
              memory: 1Gi
            limits:
              cpu: "1"
              memory: 1Gi
          securityContext:
            allowPrivilegeEscalation: false
            capabilities:
              drop: ["ALL"]
            readOnlyRootFilesystem: true
            runAsNonRoot: true
            runAsUser: 65532
          volumeMounts:
            - name: promotion
              mountPath: /etc/pertinence
              readOnly: true
            - name: benchmark-config
              mountPath: /etc/benchmark
              readOnly: true
            - name: work
              mountPath: /work
      volumes:
        - name: promotion
          configMap:
            name: promotion-dispatcher-000733
        - name: benchmark-config
          configMap:
            name: benchmark-config
        - name: work
          emptyDir: {}
