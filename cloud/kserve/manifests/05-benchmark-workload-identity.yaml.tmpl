# The IAM allow policy is intentionally managed outside Kubernetes. See iam/README.md.
apiVersion: v1
kind: Namespace
metadata:
  name: pertinence-serving
  labels:
    app.kubernetes.io/part-of: pertinence
---
apiVersion: v1
kind: ServiceAccount
metadata:
  name: benchmark-runner
  namespace: pertinence-serving
  labels:
    app.kubernetes.io/part-of: pertinence
  annotations:
    iam.gke.io/gcp-service-account: "${BENCHMARK_GSA}"
automountServiceAccountToken: true
---
apiVersion: rbac.authorization.k8s.io/v1
kind: ClusterRole
metadata:
  name: pertinence-benchmark-metrics-reader
rules:
  - apiGroups: [""]
    resources: ["nodes", "nodes/proxy", "pods"]
    verbs: ["get", "list"]
  - apiGroups: ["metrics.k8s.io"]
    resources: ["pods", "nodes"]
    verbs: ["get", "list"]
---
apiVersion: rbac.authorization.k8s.io/v1
kind: ClusterRoleBinding
metadata:
  name: pertinence-benchmark-metrics-reader
roleRef:
  apiGroup: rbac.authorization.k8s.io
  kind: ClusterRole
  name: pertinence-benchmark-metrics-reader
subjects:
  - kind: ServiceAccount
    name: benchmark-runner
    namespace: pertinence-serving
