apiVersion: v1
kind: Namespace
metadata:
  name: pertinence-serving
  labels:
    app.kubernetes.io/part-of: pertinence
---
apiVersion: v1
kind: ServiceAccount
metadata:
  name: serving-runner
  namespace: pertinence-serving
  labels:
    app.kubernetes.io/part-of: pertinence
automountServiceAccountToken: false
---
apiVersion: v1
kind: ConfigMap
metadata:
  name: promotion-dispatcher-000733
  namespace: pertinence-serving
  labels:
    app.kubernetes.io/part-of: pertinence
immutable: true
binaryData:
  promotion.json: "${PROMOTION_JSON_BASE64}"
---
apiVersion: v1
kind: ConfigMap
metadata:
  name: benchmark-config
  namespace: pertinence-serving
  labels:
    app.kubernetes.io/part-of: pertinence
immutable: true
binaryData:
  benchmark.yaml: "${BENCHMARK_CONFIG_BASE64}"
---
# Stable, cluster-internal alias. The switch script changes only this exact selector value.
apiVersion: v1
kind: Service
metadata:
  name: pertinence-active
  namespace: pertinence-serving
  labels:
    app.kubernetes.io/part-of: pertinence
spec:
  type: ClusterIP
  selector:
    serving.kserve.io/inferenceservice: router-static-resnet
  ports:
    - name: http-v2
      protocol: TCP
      port: 80
      targetPort: http-v2
