apiVersion: v1
kind: ServiceAccount
metadata:
  name: pertinence-demo
  namespace: pertinence-serving
  labels: {app.kubernetes.io/name: pertinence-demo}
automountServiceAccountToken: false
---
apiVersion: apps/v1
kind: Deployment
metadata:
  name: pertinence-demo
  namespace: pertinence-serving
  labels: {app.kubernetes.io/name: pertinence-demo}
spec:
  replicas: 1
  strategy: {type: Recreate}
  selector:
    matchLabels: {app.kubernetes.io/name: pertinence-demo}
  template:
    metadata:
      labels: {app.kubernetes.io/name: pertinence-demo}
    spec:
      serviceAccountName: pertinence-demo
      automountServiceAccountToken: false
      nodeSelector:
        cloud.google.com/gke-nodepool: serving-pool
      tolerations:
        - {key: workload, operator: Equal, value: pertinence-serving, effect: NoSchedule}
      securityContext:
        runAsNonRoot: true
        runAsUser: 65532
        runAsGroup: 65532
        seccompProfile: {type: RuntimeDefault}
      containers:
        - name: demo
          image: ${DEMO_IMAGE}
          ports: [{name: http, containerPort: 8080}]
          env:
            - name: ROUTER_URL
              value: http://demo-dispatcher-000733-predictor.pertinence-serving.svc.cluster.local
          resources:
            requests: {cpu: 250m, memory: 256Mi}
            limits: {cpu: '1', memory: 512Mi}
          securityContext:
            allowPrivilegeEscalation: false
            readOnlyRootFilesystem: true
            capabilities: {drop: [ALL]}
          startupProbe:
            httpGet: {path: /health/live, port: http}
            periodSeconds: 2
            failureThreshold: 30
          readinessProbe:
            httpGet: {path: /health/ready, port: http}
            timeoutSeconds: 3
            periodSeconds: 5
          livenessProbe:
            httpGet: {path: /health/live, port: http}
            periodSeconds: 10
---
apiVersion: v1
kind: Service
metadata:
  name: pertinence-demo
  namespace: pertinence-serving
  labels: {app.kubernetes.io/name: pertinence-demo}
spec:
  type: ClusterIP
  selector: {app.kubernetes.io/name: pertinence-demo}
  ports: [{port: 80, targetPort: http}]
