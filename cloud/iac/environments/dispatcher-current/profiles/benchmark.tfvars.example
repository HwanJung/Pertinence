    machine_type       = "n2-standard-8"
    min_count          = 0
    max_count          = 1
    initial_node_count = 0
    vcpu_per_node      = 8
  }
  serving-pool = {
    enabled            = true
    machine_type       = "n2-standard-8"
    min_count          = 0
    max_count          = 1
    initial_node_count = 0
    vcpu_per_node      = 8
  }
  loadgen-pool = {
    enabled            = true
    machine_type       = "n2-standard-4"
